# ─── LLM Provider ─────────────────────────────────────────────
# Options: ollama | openai | anthropic | groq | together | custom
LLM_PROVIDER=ollama

# ─── Ollama (local, default) ─────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── OpenAI ──────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── Anthropic ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Groq (fast inference) ───────────────────────────────────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-70b-versatile

# ─── Together AI ─────────────────────────────────────────────
# TOGETHER_API_KEY=...
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# ─── Custom OpenAI-compatible endpoint (vLLM, LM Studio, Azure, etc.)
# CUSTOM_LLM_URL=http://localhost:8080/v1
# CUSTOM_LLM_KEY=
# CUSTOM_LLM_MODEL=my-model
# CUSTOM_LLM_NAME=MyProvider
